# 1台で動かすときの設定。cp .env.example .env して埋める。
# **この .env は git に入れない**（合言葉が入る）。

# --- ここは必ず埋める ---

# ドメイン名。Caddy がこの名前で証明書を取る。
# **パスキーはこの名前に鍵が結びつく。** 後で名前を変えると、
# 登録済みのパスキーは全部使えなくなる（登録し直しになる）。
MISENARE_HOST=app.misenare.com

# 招待リンクの宛先。上と同じ名前の https にする
APP_URL=https://app.misenare.com

# パスキー。ドメイン名だけ（https:// やポートは付けない）
WEBAUTHN_RP_ID=app.misenare.com
WEBAUTHN_ORIGINS=https://app.misenare.com

# /metrics を見るための合言葉。本番では必須（無いと起動しない）
#   openssl rand -hex 24
METRICS_TOKEN=

# DB の合言葉。2つとも別の値にする
#   openssl rand -hex 24
DB_ADMIN_PASSWORD=
DB_APP_PASSWORD=

# --- ここからは任意 ---

# 内緒の値（会社アカウントの client_secret）を包む鍵。
# 決めなければ DB にそのままの形で入る。
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#MISENARE_SECRET_KEYS=k1:

# 会社のアカウント（SSO）を使うなら。相手の IdP に登録する戻り先と1文字でも違うと弾かれる
#SSO_REDIRECT_URI=https://app.misenare.com/api/auth/sso/callback

# 知らせのメール。SMTP_HOST と MAIL_FROM の両方で初めて送る
#SMTP_HOST=smtp-relay.brevo.com
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASS=
#MAIL_FROM=misenare@misenare.com

# 形態素解析。検索の当たりが良くなるが、記憶を数百MB使う
#   無料枠の小さな箱（1GB 未満）では入れないほうがよい
#TOKENIZER=kuromoji

# サーバー側のエラーを知らせる先（Slack 互換の webhook）
#ALERT_WEBHOOK_URL=

# 接続元の IP をハッシュにする鍵（台を増やすときは全台で同じ値に）
#   openssl rand -hex 16
#MISENARE_RATE_SALT=
