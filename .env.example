# PostgreSQL 16 の接続文字列
DATABASE_URL=postgresql://misenare:misenare@localhost:5432/misenare
# テストが毎回スキーマを作り直すデータベース（開発用DBとは分けること）
TEST_DATABASE_URL=postgresql://misenare:misenare@localhost:5432/misenare_test
PORT=8787
# pg（既定）または psql（pg を入れられない環境向け。開発専用）
DB_DRIVER=pg
# ロードバランサー（ALB など）の後ろに置くときは 1。X-Forwarded-For を接続元として信用する
TRUST_PROXY=0

# --- 試行回数の制限 ---
# memory（既定）はサーバーの記憶の中で数えるので、台ごとの上限になる。
# db にすると PostgreSQL で数え、台を増やしても全体で1つの上限になる
RATE_LIMIT=memory
# 接続元の IP をハッシュにするときの鍵。台をまたいで同じ印にするため、全台で同じ値にする
MISENARE_RATE_SALT=

# --- 写真の保存先 ---
# S3_BUCKET を設定しなければ、サーバーのディレクトリに保存する（開発・小規模向け）
PHOTO_DIR=./var/photos
# S3 を使うとき。中身は端末から直接 S3 に上がり、API を通らない
#S3_BUCKET=misenare-photos
#AWS_REGION=ap-northeast-1
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
# S3 互換ストレージを使うとき（省略すると AWS）
#S3_ENDPOINT=https://s3.example.com
# 写真を S3 から直接読むときは、Web 版の読み込み先にその場所を許可する
#PHOTO_ORIGIN=https://misenare-photos.s3.ap-northeast-1.amazonaws.com

# --- 監視・通知 ---
# /metrics を見るための合言葉。本番では必ず設定する（未設定だと本番では 404 を返す）
METRICS_TOKEN=
# サーバー側のエラーを知らせる先（Slack の Incoming Webhook など。{"text": …} を送る）
ALERT_WEBHOOK_URL=
# ログを止めるとき（テスト用）
#MISENARE_LOG=off

# --- 入口（ドメインが決まってから決める） ---
# どれも決めなければ、その入口が閉じているだけ。招待QRでは使える。
#
# パスキー。ドメイン名だけを入れる（https:// やポートは付けない）。
# これを決めないと、パスキーの経路が 404 になる。
#WEBAUTHN_RP_ID=misenare.example.com
# 受け付ける出どころ。WEBAUTHN_RP_ID のドメインである必要がある（端末が確かめる）
#WEBAUTHN_ORIGINS=https://misenare.example.com
# 指紋・顔・画面ロックでの確認を必須にする（既定は必須。0 で緩める）
#WEBAUTHN_REQUIRE_UV=1
#
# 会社のアカウント（SSO）。相手の IdP に登録する戻り先と、1文字でも違うと弾かれる。
#SSO_REDIRECT_URI=https://misenare.example.com/api/auth/sso/callback

# 起動時の設定の点検を飛ばす（手元で試すときだけ。本番では使わない）
#CONFIG_CHECK=off

# --- 知らせのメール ---
# Slack を使っていない会社も多いので、メールで送る。
# 会社がいま使っているメールサーバーをそのまま使える（Microsoft 365・Google
# Workspace・Amazon SES・SendGrid はどれも SMTP の窓口を持っている）。
# 決めなければメールを送らない（画面を開けば申請には気づける）。
#SMTP_HOST=smtp.example.com
# 587（STARTTLS）か 465（最初から TLS）。既定は 587
#SMTP_PORT=587
# 暗号化の仕方を手で決めるとき（1 で最初から TLS、0 で STARTTLS）
#SMTP_SECURE=
#SMTP_USER=
#SMTP_PASS=
# 社内のメールサーバーが自前の認証局を使っているとき、その証明書（PEM）の場所。
# 確かめ方を緩めるのではなく、確かめる相手を足すだけ
#SMTP_CA_FILE=/etc/misenare/mail-ca.pem
# 暗号化しないままの送信を許す（閉じた経路の社内サーバー向け。ふつうは使わない）
#SMTP_ALLOW_PLAINTEXT=
# 差出人。SMTP_HOST とこれの両方が決まって初めてメールを送る
#MAIL_FROM=misenare@example.com
# 返信先（差出人と変えるとき）
#MAIL_REPLY_TO=

# --- 内緒の値を包む鍵 ---
# 会社アカウント（SSO）の client_secret を、DB に入れる前に包む。
# 守りたいのは「DB の中身だけが漏れる」場合（バックアップの置き間違い、
# 読み取り用の複製、調査で引いた結果が手元に残る、DB の台だけの乗っ取り）。
# 鍵はここ（アプリ側）にあるので、DB だけでは開けない。
#
# 作り方: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 形: 名前:鍵 をカンマで並べる（入れ替えのために複数持てる）
#MISENARE_SECRET_KEYS=k1:aGVyZS1nb2VzLWEtMzItYnl0ZS1rZXktaW4tYjY0
# これから包むのに使う鍵（省略すると並びの最後）
#MISENARE_SECRET_KEY_ID=k1
#
# 入れ替えの順番（止めずに替えられる）:
#   1. 新しい鍵を MISENARE_SECRET_KEYS に足す（古いものは残す）
#   2. MISENARE_SECRET_KEY_ID を新しい鍵に向けて、アプリを入れ替える
#   3. npx tsx apps/api/src/cli/rekey.ts を流す
#   4. 古い鍵を外して、アプリを入れ替える
