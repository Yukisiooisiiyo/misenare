# PostgreSQL 16 の接続文字列
DATABASE_URL=postgresql://misenare:misenare@localhost:5432/misenare
# テストが毎回スキーマを作り直すデータベース（開発用DBとは分けること）
TEST_DATABASE_URL=postgresql://misenare:misenare@localhost:5432/misenare_test
PORT=8787
# pg（既定）または psql（pg を入れられない環境向け。開発専用）
DB_DRIVER=pg
# ロードバランサー（ALB など）の後ろに置くときは 1。X-Forwarded-For を接続元として信用する
TRUST_PROXY=0

# --- 写真の保存先 ---
# S3_BUCKET を設定しなければ、サーバーのディレクトリに保存する（開発・小規模向け）
PHOTO_DIR=./var/photos
# S3 を使うとき。中身は端末から直接 S3 に上がり、API を通らない
#S3_BUCKET=misenare-photos
#AWS_REGION=ap-northeast-1
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
# S3 互換ストレージを使うとき（省略すると AWS）
#S3_ENDPOINT=https://s3.example.com
# 写真を S3 から直接読むときは、Web 版の読み込み先にその場所を許可する
#PHOTO_ORIGIN=https://misenare-photos.s3.ap-northeast-1.amazonaws.com
