{
  "name": "misenare",
  "private": true,
  "version": "0.1.0",
  "description": "店舗スタッフ向けナレッジSaaS（仮称：ミセナレ）",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "tsx --test --test-concurrency=1 packages/search-core/test/*.test.ts apps/api/test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx apps/api/src/cli/migrate.ts",
    "bootstrap": "tsx apps/api/src/cli/bootstrap.ts",
    "batch:nightly": "tsx apps/api/src/batch/nightly.ts",
    "dev:api": "tsx watch apps/api/src/server.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0"
  }
}
